# uv
.uv/
# uv.lock IS committed on purpose: it pins the exact toolchain so CI, local dev and the Docker
# image all resolve identically, and it lets Dependabot propose reviewed lockfile bumps.
.gitnexus

# Per-developer MCP tool state (Serena writes .serena/project.yml + its own .gitignore on first
# index). Left untracked it still shows up in `git status --porcelain`, which is what run-manifest
# provenance reads to set `code_ref.dirty` — so an unrelated local tool directory was marking every
# published manifest as produced from a dirty tree.
.serena/

# Downloaded research inputs and generated local validation evidence.
/research-data/
.superpowers/

# so4gp writes GRAANK_<timestamp>.csv/.txt (discover) and TGrad_<timestamp>.csv/.txt (discover_tgp) to the cwd (no flag
# to disable).
GRAANK_*.csv
GRAANK_*.txt
TGrad_*.csv
TGrad_*.txt

# zones.parquet is generated on demand by scripts/generate_zones.py — its Snappy
# data pages are not byte-reproducible across machines (even at an identical
# DuckDB build), so committing the binary guarantees spurious working-tree drift.
# zones/zones.geojson stays the canonical, committed B1 artifact.
zones/zones.parquet


