{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deposium.ai/schemas/geoai-rw2/registration-status/v1",
  "title": "GeoAI worker registration status v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registration_id",
    "job_id",
    "status",
    "dataset_id",
    "attempt",
    "retryable",
    "artifact_version",
    "manifest_sha256",
    "error",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": "geoai-rw2/v1" },
    "registration_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "job_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "status": {
      "enum": [
        "queued",
        "validating",
        "validated",
        "manifest_published",
        "catalog_pending",
        "registered",
        "failed",
        "cancelled"
      ]
    },
    "dataset_id": { "type": "string", "minLength": 1, "maxLength": 255 },
    "attempt": { "type": "integer", "minimum": 0 },
    "retryable": { "type": "boolean" },
    "artifact_version": {
      "oneOf": [
        { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        { "type": "null" }
      ]
    },
    "manifest_sha256": {
      "oneOf": [
        { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        { "type": "null" }
      ]
    },
    "error": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "stage", "message", "retryable"],
          "properties": {
            "code": { "type": "string", "minLength": 1, "maxLength": 128 },
            "stage": {
              "enum": [
                "queued",
                "validating",
                "manifest_published",
                "catalog_pending"
              ]
            },
            "message": { "type": "string", "minLength": 1, "maxLength": 500 },
            "retryable": { "type": "boolean" }
          }
        }
      ]
    },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "registered" } } },
      "then": {
        "properties": {
          "artifact_version": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "error": { "type": "null" },
          "retryable": { "const": false }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "failed" } } },
      "then": {
        "properties": {
          "error": { "type": "object" }
        }
      }
    },
    {
      "$comment": "Pre-validation states carry no digests: the worker computes the artifact digest during validation and the manifest digest at publication.",
      "if": { "properties": { "status": { "enum": ["queued", "validating"] } } },
      "then": {
        "properties": {
          "artifact_version": { "type": "null" },
          "manifest_sha256": { "type": "null" }
        }
      }
    },
    {
      "$comment": "The manifest digest cannot exist before the manifest is published.",
      "if": { "properties": { "status": { "const": "validated" } } },
      "then": {
        "properties": {
          "manifest_sha256": { "type": "null" }
        }
      }
    },
    {
      "$comment": "Post-publication states MUST carry both digests: a lost ACK resumes from catalog_pending and the ACK tuple (dataset_id, artifact_version, manifest_sha256) requires them.",
      "if": {
        "properties": {
          "status": { "enum": ["manifest_published", "catalog_pending"] }
        }
      },
      "then": {
        "properties": {
          "artifact_version": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    },
    {
      "$comment": "Top-level retryable and error.retryable must agree on a failed status — one consumer must not retry while another stops.",
      "if": {
        "properties": {
          "status": { "const": "failed" },
          "retryable": { "const": true }
        },
        "required": ["status", "retryable"]
      },
      "then": {
        "properties": {
          "error": { "properties": { "retryable": { "const": true } } }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "failed" },
          "retryable": { "const": false }
        },
        "required": ["status", "retryable"]
      },
      "then": {
        "properties": {
          "error": { "properties": { "retryable": { "const": false } } }
        }
      }
    }
  ]
}
