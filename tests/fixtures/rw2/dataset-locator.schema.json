{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deposium.ai/schemas/geoai-rw2/dataset-locator/v1",
  "title": "GeoAI dataset locator v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "file_id", "artifact_kind"],
      "properties": {
        "kind": { "const": "app_artifact" },
        "file_id": { "type": "integer", "minimum": 1 },
        "document_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "artifact_kind": { "const": "geoparquet" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "dataset_alias"],
      "properties": {
        "kind": { "const": "science_dataset" },
        "dataset_alias": {
          "type": "string",
          "pattern": "^science:[a-z0-9][a-z0-9:_-]{2,126}$"
        }
      }
    }
  ]
}
