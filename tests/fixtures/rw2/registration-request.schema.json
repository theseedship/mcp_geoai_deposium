{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deposium.ai/schemas/geoai-rw2/registration-request/v1",
  "title": "GeoAI worker registration request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registration_id",
    "idempotency_key",
    "dataset_id",
    "tenant_id",
    "folder_id",
    "file_id",
    "document_id",
    "source",
    "artifact_kind",
    "requested_at"
  ],
  "properties": {
    "schema_version": { "const": "geoai-rw2/v1" },
    "registration_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "idempotency_key": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "dataset_id": { "type": "string", "minLength": 1, "maxLength": 255 },
    "tenant_id": { "type": "string", "minLength": 1, "maxLength": 255 },
    "folder_id": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "file_id": { "type": "integer", "minimum": 1 },
    "document_id": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 255 },
        { "type": "null" }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bucket", "key", "etag"],
      "properties": {
        "bucket": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{1,62}$"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "$comment": "Server-resolved RustFS object key mirroring the worker's valid_relative_object_key: non-empty [A-Za-z0-9._-] segments joined by single '/' — no leading/trailing '/', no '//', no ':' (URI schemes), and no '.' or '..' path segments (the 'not' kills dot-segments).",
          "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$",
          "not": { "pattern": "(^|/)\\.\\.?(/|$)" }
        },
        "etag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "not": {
            "anyOf": [
              { "pattern": "^W/" },
              { "pattern": "^\"+$" }
            ]
          }
        },
        "content_length": { "type": "integer", "minimum": 1 }
      }
    },
    "artifact_kind": { "const": "geoparquet" },
    "requested_at": { "type": "string", "format": "date-time" }
  }
}
