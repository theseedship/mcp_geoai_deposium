# Operator CLI only: copy to .env.solar, or set these process environment variables.
# Do not add SOLAR_* entries to the MCP server's .env.
# Public defaults are routing defaults; confirm the access plan for intended use.
SOLAR_FORECAST_API_BASE_URL=https://api.open-meteo.com/v1/forecast
SOLAR_FORECAST_API_KEY=
SOLAR_ARCHIVE_API_BASE_URL=https://archive-api.open-meteo.com/v1/archive
SOLAR_ARCHIVE_API_KEY=
SOLAR_SATELLITE_API_BASE_URL=https://satellite-api.open-meteo.com/v1/archive
SOLAR_SATELLITE_API_KEY=
# With a commercial key, explicitly use the matching endpoint:
# Forecast: https://customer-api.open-meteo.com/v1/forecast
# ERA5: https://customer-archive-api.open-meteo.com/v1/archive
# Satellite: https://customer-satellite-api.open-meteo.com/v1/archive
