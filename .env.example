# Optional local configuration; copy to .env and adjust as needed.
# These settings are read by the server. Compose-only settings belong in your shell.
MCP_TRANSPORT=http
HOST=127.0.0.1
PORT=5001
# Choose a unique bearer of at least 32 characters for shared HTTP/SSE use.
# Required whenever S3, local Parquet or solar data-plane access is enabled.
GEOAI_MESH_AUTH_TOKEN=

STAC_URL=https://earth-search.aws.element84.com/v1
DUCKDB_PATH=./data/geoai.duckdb
IMAGE_CACHE_DIR=./data/images
MODEL_CACHE_DIR=./data/models

# Optional S3-compatible storage. No object store is launched by Compose.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_FORCE_PATH_STYLE=true

# Local files remain disabled until both opt-in and allowed root are set.
ALLOW_LOCAL_PARQUET_SOURCE=false
LOCAL_PARQUET_SOURCE_ROOT=

# Configure the matching endpoint and API plan for your use.
FORECAST_API_BASE_URL=https://api.open-meteo.com/v1/forecast
FORECAST_API_KEY=
FORECAST_ENABLE_AI=true
FORECAST_AI_MODEL=ecmwf_aifs025_single
FORECAST_PHYSICAL_MODEL=
FORECAST_TIMEOUT_S=5.0
FORECAST_MAX_DAYS=16

DEFAULT_CLOUD_COVER_MAX=20
MAX_BBOX_AREA_DEG2=1.0
DEFAULT_NDVI_STRESS_THRESHOLD=0.3
DEFAULT_NDVI_DROP_THRESHOLD=0.2
USE_GPU=false
LOG_LEVEL=INFO
LOG_FORMAT=json
